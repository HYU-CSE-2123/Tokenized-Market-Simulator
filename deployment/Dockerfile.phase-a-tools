# Test-only offline compiler reuse. No runtime mounts, secrets, DB or old chain are copied.
FROM tokenized-reserve-tools:reserve-e2e-20261009043259-4ac3a5 AS compiler
FROM ghcr.io/foundry-rs/foundry@sha256:0c00cb0bda1ab1b91c9a6bf60f4c76c09c1a8870824b6d4718afbabacf6f9a17
USER root
WORKDIR /contracts
COPY --from=compiler /root/.svm/0.8.24/solc-0.8.24 /root/.svm/0.8.24/solc-0.8.24
COPY contracts/src ./src
COPY contracts/lib ./lib
COPY contracts/script/DeployPublic.s.sol ./script/DeployPublic.s.sol
COPY deployment/foundry.toml ./foundry.toml
COPY deployment/init-chain.sh /init-chain.sh
RUN sed -i 's/\r$//' /init-chain.sh && chmod 755 /init-chain.sh && forge build --offline
ENTRYPOINT ["/bin/sh", "/init-chain.sh"]
