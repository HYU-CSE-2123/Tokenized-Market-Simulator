# Non-secret release configuration only. Secrets are files, never Compose environment.
PUBLIC_DOMAIN=demo.example.com
PUBLIC_ORIGIN=https://demo.example.com
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
DATA_ROOT=/srv/exchange/data
RUNTIME_ROOT=/srv/exchange/runtime/current
KNOWLEDGE_ROOT=/srv/exchange/artifacts/knowledge
CERT_ROOT=/srv/exchange/certificates
BACKEND_IMAGE=tokenized-market-backend:release
WEB_IMAGE=tokenized-market-web:release
# Set immutable tested digests before AWS release. No latest tags.
POSTGRES_IMAGE=postgres:16-alpine
AI_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16@sha256:eac621400b7b7ff52493883e41e930e3d104695fea5b68cc0c42370cf7880067
ANVIL_IMAGE=ghcr.io/foundry-rs/foundry@sha256:0c00cb0bda1ab1b91c9a6bf60f4c76c09c1a8870824b6d4718afbabacf6f9a17
SIMULATION_SEED=20261006
SIMULATION_BOOTSTRAP_DAYS=2
