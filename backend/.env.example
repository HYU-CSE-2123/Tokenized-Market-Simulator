# 복사해서 .env로 사용하세요. .env는 Git에서 제외됩니다.

DB_URL=jdbc:postgresql://localhost:5432/exchange
DB_USERNAME=exchange
DB_PASSWORD=exchange
SERVER_PORT=8082
WEBSOCKET_ALLOWED_ORIGINS=*

# 반드시 각 개발 환경에서 직접 설정하세요.
# JWT_SECRET=32바이트-이상의-충분히-긴-무작위-문자열
JWT_VALIDITY_MS=3600000

ADMIN_LOGIN_ID=admin
# ADMIN_PASSWORD=8자-이상의-관리자-비밀번호
ADMIN_NICKNAME=Admin

# simulated 또는 toss. toss 선택 시 아래 자격 증명과 토스증권 허용 IP 등록이 필요합니다.
PRICE_PROVIDER=simulated
PRICE_INTERVAL_MS=1000
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_SYMBOL=005930
TOSS_CONNECT_TIMEOUT=2s
TOSS_READ_TIMEOUT=5s
TOSS_WEBSOCKET_URL=wss://openapi-ws.tossinvest.com/ws/v1
TOSS_WEBSOCKET_PING_INTERVAL=60s
TOSS_WEBSOCKET_RECONNECT_INITIAL_DELAY=1s
TOSS_WEBSOCKET_RECONNECT_MAX_DELAY=30s
TOSS_PRICE_DEGRADED_AFTER=15s
TOSS_PRICE_STALE_AFTER=60s
TOSS_REFERENCE_REFRESH_CRON=0 5 0 * * *
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=
BLOCKCHAIN_ENABLED=false
RPC_URL=http://127.0.0.1:8545
MOCK_KRW_ADDRESS=
MSEC_ADDRESS=
PRICE_ORACLE_ADDRESS=
EXCHANGE_VAULT_ADDRESS=

# 실제 개인키를 저장소에 커밋하지 마세요.
# OPERATOR_PRIVATE_KEY=
# Oracle에 등록한 priceSigner 주소의 전용 개인키이며 운영자 거래 키와 분리합니다.
PRICE_REPORT_SIGNING_ENABLED=false
# PRICE_SIGNER_PRIVATE_KEY=
BLOCKCHAIN_RECEIPT_POLL_INTERVAL_MS=1000
BLOCKCHAIN_RECEIPT_INITIAL_DELAY_MS=1000
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=1

# Basic RAG는 기본 비활성. 실제 키는 로컬 .env에만 보관한다.
AI_ENABLED=false
# Read-only Tool은 RAG·외부 AI API·AI DB와 독립적으로 활성화한다.
AI_TOOLS_ENABLED=false
AI_AGENT_ENABLED=false
AI_SKILLS_ENABLED=false
# Explicit ADMIN POST /api/ai/diagnoses/index initializes the isolated AI history schema.
AI_AUTO_DIAGNOSIS_ENABLED=false
AI_DIAGNOSIS_ACTOR_LOGIN_ID=admin
# Set a stable unique ledger identity; change after resetting the trading ledger/chain.
AI_DIAGNOSIS_SOURCE_NAMESPACE=local-ledger-1
AI_DIAGNOSIS_POLL_INTERVAL_MS=5000
AI_DIAGNOSIS_BATCH_SIZE=50
AI_DIAGNOSIS_QUEUE_LIMIT=100
AI_DIAGNOSIS_DAILY_LIMIT=20
AI_DIAGNOSIS_RETENTION_DAYS=7
AI_DB_URL=jdbc:postgresql://127.0.0.1:5433/exchange_ai
AI_DB_USERNAME=exchange_ai
AI_DB_PASSWORD=
AI_KNOWLEDGE_ROOT=../docs/ai-knowledge
AI_MANIFEST=../docs/ai/ingest-manifest.json
# OPENAI_API_KEY
# 보수적 UTF-8 byte 상한. 변경 후 명시적 재색인이 필요하다.
AI_CHUNK_TOKENS=1200
AI_OVERLAP_TOKENS=60
AI_TOP_K=5
AI_MINIMUM_SIMILARITY=0.25
AI_TIMEOUT_SECONDS=20
